name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '{{node_version}}'
          cache: 'npm'
      - name: npm ci
        run: npm ci
      - name: make check
        run: make check
