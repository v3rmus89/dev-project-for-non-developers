{%- set pm = package_manager | default("pip") -%}
[project]
name = "{{project_name}}"
version = "0.1.0"
description = "{{project_name}} — bootstrapped by dev-project-setup"
requires-python = ">={{python_version}}"
dependencies = []
{% if pm == "uv" %}
[dependency-groups]
dev = [
    "ruff==0.15.12",
    "pytest>=8.0,<9",
    "pre-commit>=3.7,<5",
]
{%- else %}
[tool.setuptools]
py-modules = []

[tool.setuptools.packages.find]
where = ["src"]
{%- endif %}

[tool.ruff]
line-length = 100
target-version = "py{{python_version | replace('.', '')}}"
extend-exclude = ["venv", ".venv", "__pycache__"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "RUF", "SIM"]
ignore = ["E501"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "--strict-config --strict-markers"
