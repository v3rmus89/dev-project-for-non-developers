name: Claude review

# Automatic PR review by Claude. Advisory (not required for merge).
#
# Auth model: subscription-friendly OAuth token (Claude Pro/Max), NOT a
# per-token-billed Anthropic API key. The token is generated by running
# `claude setup-token` locally and added to GitHub Secrets as
# CLAUDE_CODE_OAUTH_TOKEN.

on:
  pull_request:
    types: [opened, synchronize, ready_for_review]
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

# Concurrency: cancel-in-progress per (PR, event_name). Splitting per event
# means rapid pushes (same event) still cancel each other, but review
# comments from other bots don't murder Claude's first review.
concurrency:
  group: claude-review-{% raw %}${{ github.event.pull_request.number || github.event.issue.number }}-${{ github.event_name }}{% endraw %}
  cancel-in-progress: true

jobs:
  claude-review:
    if: {% raw %}|
      (github.event_name == 'pull_request'
        && github.event.pull_request.head.repo.full_name == github.repository)
      || (github.event_name == 'issue_comment'
        && contains(github.event.comment.body, '@claude'))
      || (github.event_name == 'pull_request_review_comment'
        && contains(github.event.comment.body, '@claude')){% endraw %}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
      id-token: write
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Claude review
        uses: anthropics/claude-code-action@beta
        with:
          claude_code_oauth_token: {% raw %}${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}{% endraw %}
          # Explicit model pin: the @beta action's built-in default
          # (claude-sonnet-4) was retired 2026-06-15 and 404s every run.
          # claude-sonnet-5 is the complete, undated model ID - bump it
          # deliberately when Anthropic deprecates the Sonnet 5 line.
          model: claude-sonnet-5
          direct_prompt: |
            You are reviewing a pull request for {{project_name}}
            ({{github_owner}}/{{github_repo}}).

            Read `AGENTS.md` and `CLAUDE.md` at the repo root for repo-specific
            guidance. They document the bug classes that matter for this
            project — review against THOSE, not against any baked-in domain
            assumptions. If those files are absent or thin, fall back to:

            Focus on:
            - Real bugs (logic errors, missed edge cases, regressions)
            - Security / secrets / authentication concerns
            - Missing tests for new helpers or public APIs
            - Documentation accuracy (claims that don't match the code)

            Avoid:
            - Style nits — `make format` (ruff/biome/gofumpt depending on
              language) handles those automatically
            - Items parked in `BACKLOG.md`
            - Wholesale rewrites — concise targeted fixes are far more useful

            Tone: concise, evidence-based, with file:line citations. 1-2
            sentences per finding plus a clear "do X" or "change Y to Z".
